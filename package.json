{
  "name": "alemonjs-quote-card",
  "version": "1.1.0",
  "description": "名言卡片（quote-card）ALemonJS 版：引用一条消息生成名言卡片，支持自定义背景与分辨率",
  "author": "Looking08",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "build": "lvy build && node -e \"require('fs').cpSync('src/quote-card/assets','lib/quote-card/assets',{recursive:true})\""
  },
  "exports": {
    ".": {
      "import": "./lib/index.js"
    },
    "./package": "./package.json"
  },
  "dependencies": {
    "jsxp": "^1.4.0"
  },
  "peerDependencies": {
    "alemonjs": ">=2.1.100"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "alemonjs": "^2.1.112",
    "koa-router": "^14.0.0",
    "lvyjs": "^0.3.1"
  },
  "keywords": [
    "alemonjs",
    "quote-card",
    "名言",
    "名言卡片"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "bugs": "https://github.com/Looking08/yunzai-plugin-quote-card/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/Looking08/yunzai-plugin-quote-card.git"
  }
}
